# 服务地址
ADDR=127.0.0.1:9500
# 特征快照（由 `python -m featureline build` 生成）
SNAPSHOT=data/redis_snapshot.json

# ---- read 泳道（在线特征查询 /v1/features/*）----
# 同时在途的查询上限；超出后请求进入有界队列
READ_MAX_IN_FLIGHT=64
# 排队队列长度；队列满即主动拒绝（503 overload_rejected），不会无限排队
READ_MAX_QUEUED=128
# 排队最长等待；超时返回 504 queue_timeout（可重试）
READ_QUEUE_TIMEOUT=200ms
# 单个查询的处理期限；超时返回 504 deadline_exceeded（可重试，结果未知）
READ_HANDLE_TIMEOUT=2s

# ---- admin 泳道（后台写入 /v1/admin/*），与 read 完全隔离 ----
ADMIN_MAX_IN_FLIGHT=4
ADMIN_MAX_QUEUED=16
ADMIN_QUEUE_TIMEOUT=500ms
ADMIN_HANDLE_TIMEOUT=5s

# ---- 优雅关闭预算：等待在途/排队请求排空的最长时间 ----
SHUTDOWN_TIMEOUT=10s
